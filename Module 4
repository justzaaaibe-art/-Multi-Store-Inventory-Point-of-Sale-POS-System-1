#ifndef PAYMENT_H
#define PAYMENT_H
#include <iostream>
#include <string>
using namespace std;
class Payment {
private:
    int transactionId;
    string method;
    string status;
public:
    Payment(int tid, string m, string s) {
        transactionId = tid;
        method = m;
        status = s;
    }
   ~Payment() {
        cout << "Payment session ended.\n";
    }

    void setStatus(string s) { status = s; }

    int getTransactionId() { return transactionId; }
    string getMethod() { return method; }
    string getStatus() { return status; }
};
#endif
